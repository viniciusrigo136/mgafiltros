# Login: desligado por padrão (o sistema abre direto). Para exigir usuário e senha, use 1.
REQUIRE_LOGIN=0

# Só necessário com REQUIRE_LOGIN=1: segredo do cookie de sessão (mín. 32 caracteres aleatórios).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Caminho do arquivo do banco SQLite (padrão: data/mga.db). Faça backup deste arquivo.
DATABASE_PATH=data/mga.db
