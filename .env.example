# ---- Banco de dados (obrigatório na Vercel) ----
# Turso: crie o banco em https://turso.tech e copie a URL (libsql://...) e um token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Sem TURSO_DATABASE_URL (só no computador local), usa este arquivo SQLite:
DATABASE_PATH=data/mga.db

# ---- Fotos e PDFs (obrigatório na Vercel para anexos) ----
# Criado automaticamente ao conectar um Blob Store (privado) ao projeto na Vercel.
BLOB_READ_WRITE_TOKEN=

# ---- Login (opcional) ----
# Desligado por padrão. Para exigir usuário e senha, use 1 e defina SESSION_SECRET.
REQUIRE_LOGIN=0
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
